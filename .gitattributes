# 默认：让 Git 自动判断文本/二进制
* text=auto

# 脚本和常见文本文件统一 LF
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Windows 批处理文件必须用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件禁止换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary